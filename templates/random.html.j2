{% extends "base.html.j2" %}
{% block body %}
  <script>
    const apps = [
      {% for app in apps %}
        {% if app.visible %}
          "./{{ app.id }}.html",
        {% endif %}
      {% endfor %}
    ];
    const app = apps[Math.floor(Math.random() * apps.length)];
    window.location.replace(app);
  </script>
{% endblock %}
